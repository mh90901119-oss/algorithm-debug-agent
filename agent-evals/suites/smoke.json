      "expectedCollectionCompletion": "SUCCESS",
      "maxTargetTestExecutions": 2,
      "expectedGanttOutcome": "PRESENT"
    },
    {
      "id": "jdwp-independent",
      "question": "Run the UT and independently use JDWP to collect one focused runtime state observation relevant to the scheduling loop. Do not run CodePath first.",
      "targetTest": {
