{
  "schemaVersion": "1.0",
  "suiteId": "algorithm-debug-smoke",
  "description": "Nine real OpenCode scenarios covering pass, missing UT, target failures, independent collectors and Artifact integrity",
  "cases": [
    {
      "id": "passing-ut",
      "question": "Run the target UT and explain whether it passed and whether a Gantt JSON was archived.",
      "targetTest": {
        "className": "org.example.scheduler.wafer.WaferSchedulingReproductionTest",
        "methodName": "reproduceComplexSchedulingFromTimestampedInput"
      },
      "requiredTools": [
        "analysis_begin",
        "algorithm_input_capture",
        "run_test",
        "case_audit",
        "analysis_complete"
      ],
      "forbiddenTools": [],
      "expectedProcessOutcome": "SUCCEEDED",
      "expectedTestOutcome": "PASSED",
      "requiredAnswerPatterns": [
        "passed|success"
      ],
      "forbiddenAnswerPatterns": [],
      "requireAnalysisComplete": true,
      "requireEvidenceReferences": true,
      "allowCodePath": false,
      "allowJdwp": false,
      "maxTargetTestExecutions": 1,
      "expectedGanttOutcome": "PRESENT"
    },
    {
      "id": "missing-ut",
      "question": "Check this requested target UT. If it does not exist, report that fact and stop without dynamic collection.",
      "targetTest": {
        "className": "org.example.scheduler.wafer.DoesNotExistTest",
        "methodName": "missingTarget"
      },
      "requiredTools": [
        "analysis_begin",
        "algorithm_input_capture",
        "case_audit",
        "analysis_complete"
      ],
      "forbiddenTools": [
        "codepath_plan_create",
        "codepath_collect",
        "jdwp_plan_create",
        "jdwp_collect"
      ],
      "requiredAnswerPatterns": [
        "does not exist|not found|not confirmed to exist"
      ],
      "forbiddenAnswerPatterns": [
        "root cause.*algorithm"
      ],
      "requireAnalysisComplete": true,
      "requireEvidenceReferences": false,
      "allowCodePath": false,
      "allowJdwp": false,
      "maxTargetTestExecutions": 0
    },
    {
      "id": "missing-input",
      "question": "Check whether this UT has exactly one supported algorithm input. If it does not, explain the unsupported target and stop without running it.",
      "targetTest": {
        "className": "org.example.scheduler.wafer.WaferSchedulingFailureScenarios",
        "methodName": "missingAlgorithmInputCausesNullPointerException"
      },
      "requiredTools": [
        "analysis_begin",
        "algorithm_input_capture",
        "case_audit",
        "analysis_complete"
      ],
      "forbiddenTools": [
        "run_test",
        "codepath_plan_create",
        "codepath_collect",
        "jdwp_plan_create",
        "jdwp_collect"
      ],
      "requiredAnswerPatterns": [
        "algorithm input|input.*not found|unsupported target"
      ],
      "forbiddenAnswerPatterns": [],
      "requireAnalysisComplete": true,
      "requireEvidenceReferences": false,
      "allowCodePath": false,
      "allowJdwp": false,
      "maxTargetTestExecutions": 0
    },
    {
      "id": "algorithm-loop-guard",
      "question": "Explain the runtime exception root cause and the algorithm logic category where it occurs.",
      "targetTest": {
        "className": "org.example.scheduler.wafer.WaferSchedulingFailureScenarios",
        "methodName": "schedulingLoopExceedsMaximumIterations"
      },
      "requiredTools": [
        "analysis_begin",
        "algorithm_input_capture",
        "run_test",
        "case_audit",
        "analysis_complete"
      ],
      "forbiddenTools": [],
      "expectedProcessOutcome": "FAILED",
      "expectedTestOutcome": "ERROR",
      "expectedExceptionClass": "java.lang.IllegalStateException",
      "requiredAnswerPatterns": [
        "maximum iterations|loop"
      ],
      "forbiddenAnswerPatterns": [
        "input is missing"
      ],
      "requireAnalysisComplete": true,
      "requireEvidenceReferences": true,
      "allowCodePath": false,
      "allowJdwp": false,
      "maxTargetTestExecutions": 1,
      "expectedGanttOutcome": "ABSENT"
    },
    {
      "id": "assertion-failure",
      "question": "Determine whether this failure is an algorithm exception or a test expectation mismatch.",
      "targetTest": {
        "className": "org.example.scheduler.wafer.WaferSchedulingFailureScenarios",
        "methodName": "generatedScheduleHasIntentionalAssertionMismatch"
      },
      "requiredTools": [
        "analysis_begin",
        "algorithm_input_capture",
        "run_test",
        "case_audit",
        "analysis_complete"
      ],
      "forbiddenTools": [],
      "expectedProcessOutcome": "FAILED",
      "expectedTestOutcome": "FAILED",
      "expectedExceptionClass": "org.opentest4j.AssertionFailedError",
      "requiredAnswerPatterns": [
        "164",
        "165",
        "assertion|expectation"
      ],
      "forbiddenAnswerPatterns": [
        "input is missing"
      ],
      "requireAnalysisComplete": true,
      "requireEvidenceReferences": true,
      "allowCodePath": false,
      "allowJdwp": false,
      "maxTargetTestExecutions": 1,
      "expectedGanttOutcome": "PRESENT"
    },
    {
      "id": "static-current-source",
      "question": "Run the UT, then use current-source static analysis to identify the bounded direct call structure relevant to the target method.",
      "targetTest": {
        "className": "org.example.scheduler.wafer.WaferSchedulingReproductionTest",
        "methodName": "reproduceComplexSchedulingFromTimestampedInput"
      },
      "requiredTools": [
        "analysis_begin",
        "algorithm_input_capture",
        "run_test",
        "static_analyze",
        "case_audit",
        "analysis_complete"
      ],
      "forbiddenTools": [],
      "expectedProcessOutcome": "SUCCEEDED",
      "expectedTestOutcome": "PASSED",
      "requiredAnswerPatterns": [
        "source|method|call"
      ],
      "forbiddenAnswerPatterns": [
        "complete call graph"
      ],
      "requireAnalysisComplete": true,
      "requireEvidenceReferences": true,
      "allowCodePath": false,
      "allowJdwp": false,
      "maxTargetTestExecutions": 1,
      "expectedGanttOutcome": "PRESENT"
    },
    {
      "id": "codepath-independent",
      "question": "Run the UT and independently collect the runtime method path needed to explain which methods actually executed. Do not use JDWP.",
      "targetTest": {
        "className": "org.example.scheduler.wafer.WaferSchedulingReproductionTest",
        "methodName": "reproduceComplexSchedulingFromTimestampedInput"
      },
      "requiredTools": [
        "analysis_begin",
        "algorithm_input_capture",
        "run_test",
        "static_analyze",
        "codepath_plan_create",
        "codepath_collect",
        "case_audit",
        "analysis_complete"
      ],
      "forbiddenTools": [
        "jdwp_plan_create",
        "jdwp_collect"
