        "codepath_collect"
      ],
      "expectedProcessOutcome": "SUCCEEDED",
      "expectedTestOutcome": "PASSED",
      "requiredAnswerPatterns": [
        "JDWP|runtime state"
      ],
      "forbiddenAnswerPatterns": [],
      "requireAnalysisComplete": true,
      "requireEvidenceReferences": true,
      "allowCodePath": false,
      "allowJdwp": true,
      "expectedCollectionCompletion": "SUCCESS",
      "maxTargetTestExecutions": 2,
      "expectedGanttOutcome": "PRESENT"
    },
