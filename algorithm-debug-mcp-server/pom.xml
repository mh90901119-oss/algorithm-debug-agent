<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.example.algorithmdebug</groupId>
        <artifactId>algorithm-debug-agent-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>algorithm-debug-mcp-server</artifactId>
    <name>ADA MCP Server</name>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>../schemas/mcp/tools</directory>
                <targetPath>schemas/mcp/tools</targetPath>
            </resource>
            <resource>
                <directory>../schemas/tool</directory>
                <targetPath>schemas/tool</targetPath>
                <includes>
                    <include>coordinated-tool-result-v1.schema.json</include>
                    <include>evidence-query-result-v2.schema.json</include>
                </includes>
            </resource>
            <resource>
                <directory>../schemas/coordination</directory>
                <targetPath>schemas/coordination</targetPath>
                <includes>
                    <include>conclusion-candidate-v2.schema.json</include>
                </includes>
            </resource>
            <resource>
                <directory>../agent-definition</directory>
                <targetPath>agent-definition</targetPath>
                <includes>
                    <include>algorithm-debug-agent-v1.json</include>
                    <include>capability-manifest-v1.json</include>
                    <include>system-prompt-v1.md</include>
                    <include>completion-contract-v1.schema.json</include>
                </includes>
            </resource>
            <resource>
                <directory>../schemas/agent</directory>
                <targetPath>schemas/agent</targetPath>
            </resource>
            <resource>
                <directory>../schemas/config</directory>
                <targetPath>schemas/config</targetPath>
                <includes>
                    <include>mcp-agent-settings-v1.schema.json</include>
                </includes>
            </resource>
            <resource>
                <directory>..</directory>
                <targetPath>META-INF</targetPath>
                <includes>
                    <include>THIRD_PARTY_NOTICES.md</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>all</shadedClassifierName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>org.example.algorithmdebug.mcp.AlgorithmDebugMcpMain</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <dependency>
            <groupId>org.example.algorithmdebug</groupId>
            <artifactId>ada-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.example.algorithmdebug</groupId>
            <artifactId>case-management</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.example.algorithmdebug</groupId>
            <artifactId>algorithm-debug-runtime</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.example.algorithmdebug</groupId>
            <artifactId>maven-junit-adapter</artifactId>
            <version>${project.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.modelcontextprotocol.sdk</groupId>
            <artifactId>mcp-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.modelcontextprotocol.sdk</groupId>
            <artifactId>mcp-json-jackson2</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jdk8</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
