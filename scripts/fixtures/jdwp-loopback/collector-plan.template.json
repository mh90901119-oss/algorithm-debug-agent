{
  "schemaVersion": "5.0",
  "sessionId": "jdwp-loopback-verification",
  "target": {"host": "127.0.0.1", "port": __PORT__},
  "resumeOnAttach": true,
  "idleTimeoutMillis": 5000,
  "maxEvents": 10,
  "tracepoints": [{
    "id": "probe-marker",
    "className": "JdwpLoopbackProbe",
    "line": __LINE__,
    "methodName": "inspect",
    "methodDescriptor": "(I)I",
    "maxObservedHits": 1,
    "maxCapturedHits": 1,
    "captureFirstMatchedHits": 1,
    "captureEveryMatchedHits": 0,
    "conditions": [{
      "valuePath": "marker",
      "operator": "EQUALS",
      "expectedType": "LONG",
      "expectedValue": "42"
    }],
    "capture": {
      "stack": true,
      "maxFrames": 4,
      "maxStringLength": 128,
      "valuePaths": ["marker"]
    }
  }]
}
