{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://algorithm-debug-agent.local/schemas/agent-completion-v1.schema.json",
  "title": "Algorithm Debug Agent Completion Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "caseId",
    "analysisId",
    "status",
    "claims",
    "causalChains",
    "consideredHypothesisIds",
    "refutedHypothesisIds",
    "missingEvidence",
    "limitations",
    "capabilitiesUsed"
  ],
  "properties": {
    "caseId": { "$ref": "#/$defs/identifier" },
    "analysisId": { "$ref": "#/$defs/identifier" },
    "conclusionDecisionId": { "$ref": "#/$defs/identifier" },
    "status": {
      "enum": [
        "CONFIRMED",
        "BOUNDED_HYPOTHESIS",
        "INSUFFICIENT_EVIDENCE",
        "CONTRADICTED",
        "TOOL_BLOCKED",
        "BUDGET_EXHAUSTED"
      ]
    },
    "claims": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/claim" }
    },
    "causalChains": {
      "type": "array",
      "maxItems": 20,
      "items": { "$ref": "#/$defs/causalChain" }
    },
    "consideredHypothesisIds": { "$ref": "#/$defs/identifiers" },
    "refutedHypothesisIds": { "$ref": "#/$defs/identifiers" },
    "missingEvidence": { "$ref": "#/$defs/messages" },
    "limitations": { "$ref": "#/$defs/messages" },
    "capabilitiesUsed": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 32,
      "items": {
        "enum": [
          "algorithm_input",
          "run_test",
          "static_analysis",
          "source_query",
          "gantt",
          "CodePath",
          "JDWP",
          "bounded_evidence_query",
          "case_audit"
        ]
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "identifiers": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "messages": {
      "type": "array",
      "maxItems": 100,
      "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "text", "causalElementRefs", "evidenceIds"],
      "properties": {
        "classification": {
          "enum": [
            "CONFIRMED_FACT",
            "VALIDATOR_CONCLUSION",
            "SOURCE_INFERENCE",
            "LLM_HYPOTHESIS",
            "MISSING_EVIDENCE"
          ]
        },
        "text": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "causalElementRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "evidenceIds": { "$ref": "#/$defs/identifiers" },
        "sourceQueryIds": { "$ref": "#/$defs/identifiers" }
      }
    },
    "causalChain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chainId", "nodes", "edges", "evidenceRefs", "sourceRefs"],
      "properties": {
        "chainId": { "$ref": "#/$defs/identifier" },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "$ref": "#/$defs/node" }
        },
        "edges": {
          "type": "array",
          "maxItems": 200,
          "items": { "$ref": "#/$defs/edge" }
        },
        "evidenceRefs": { "$ref": "#/$defs/identifiers" },
        "sourceRefs": { "$ref": "#/$defs/identifiers" }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeId", "type", "text"],
      "properties": {
        "nodeId": { "$ref": "#/$defs/identifier" },
        "type": {
          "enum": [
            "SYMPTOM",
            "INPUT",
            "RUNTIME_STATE",
            "DECISION",
            "SOURCE_MECHANISM",
            "UPSTREAM_CAUSE"
          ]
        },
        "text": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edgeId",
        "from",
        "to",
        "relation",
        "classification",
        "evidenceIds",
        "sourceQueryIds"
      ],
      "properties": {
        "edgeId": { "$ref": "#/$defs/identifier" },
        "from": { "$ref": "#/$defs/identifier" },
        "to": { "$ref": "#/$defs/identifier" },
        "relation": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "classification": {
          "enum": [
            "CONFIRMED_FACT",
            "VALIDATOR_CONCLUSION",
            "SOURCE_INFERENCE",
            "LLM_HYPOTHESIS",
            "MISSING_EVIDENCE"
          ]
        },
        "evidenceIds": { "$ref": "#/$defs/identifiers" },
        "sourceQueryIds": { "$ref": "#/$defs/identifiers" }
      }
    }
  }
}
