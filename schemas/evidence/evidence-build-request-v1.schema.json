{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://algorithm-debug-agent.local/schemas/evidence/evidence-build-request-v1.schema.json",
  "title": "EvidenceBuildRequest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "evidenceId", "caseId", "contextId", "analysisId", "collectionIds", "comparisonCollectionIds", "requiredDimensions", "maxSummaryBytes", "maxEvidenceBundleBytes", "createdAt"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "evidenceId": {"type": "string", "minLength": 1, "maxLength": 128},
    "caseId": {"type": "string", "minLength": 1, "maxLength": 128},
    "contextId": {"type": "string", "minLength": 1, "maxLength": 128},
    "analysisId": {"type": "string", "minLength": 1, "maxLength": 128},
    "collectionIds": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string"}},
    "comparisonCollectionIds": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string"}},
    "requiredDimensions": {"type": "array", "minItems": 1, "maxItems": 7, "uniqueItems": true, "items": {"enum": ["TARGET_OUTCOME", "INPUT", "SOURCE", "METHOD_PATH", "RUNTIME_STATE", "SCHEDULE_RESULT", "VALIDATION"]}},
    "maxSummaryBytes": {"type": "integer", "minimum": 1, "maximum": 4194304},
    "maxEvidenceBundleBytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
    "createdAt": {"type": "string", "format": "date-time"}
  }
}
