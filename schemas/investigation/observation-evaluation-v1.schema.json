{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/algorithm-debug/schemas/investigation/observation-evaluation-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "evaluationId", "caseId", "analysisId", "predicateId", "truth", "evidenceIds", "sourceCoverage", "evidenceDisposition", "effectApplied", "appliedEffect", "limitations", "inputSha256", "evaluatedAt", "evaluatorVersion"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "evaluationId": { "$ref": "#/$defs/id" }, "caseId": { "$ref": "#/$defs/id" }, "analysisId": { "$ref": "#/$defs/id" }, "predicateId": { "$ref": "#/$defs/id" },
    "truth": { "enum": ["TRUE", "FALSE", "UNKNOWN"] },
    "evidenceIds": { "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "sourceCoverage": { "enum": ["COMPLETE", "PARTIAL", "UNKNOWN"] },
    "evidenceDisposition": { "enum": ["CONFIRMATION_ELIGIBLE", "CLUE_ONLY", "INVALID"] },
    "effectApplied": { "type": "boolean" },
    "appliedEffect": { "enum": ["SUPPORT", "REFUTE", "NO_CHANGE"] },
    "limitations": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 4096 } },
    "inputSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "evaluatedAt": { "type": "string", "format": "date-time" },
    "evaluatorVersion": { "type": "string", "minLength": 1, "maxLength": 1024 }
  },
  "allOf": [
    { "if": { "properties": { "effectApplied": { "const": true } } }, "then": { "properties": { "evidenceDisposition": { "const": "CONFIRMATION_ELIGIBLE" }, "truth": { "enum": ["TRUE", "FALSE"] }, "appliedEffect": { "enum": ["SUPPORT", "REFUTE"] } } }, "else": { "properties": { "appliedEffect": { "const": "NO_CHANGE" } } } },
    { "if": { "properties": { "evidenceDisposition": { "const": "INVALID" } } }, "then": { "properties": { "truth": { "const": "UNKNOWN" } } } }
  ],
  "$defs": { "id": { "type": "string", "minLength": 1, "maxLength": 128 } }
}
