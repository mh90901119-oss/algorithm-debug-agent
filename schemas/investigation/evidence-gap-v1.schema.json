{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/algorithm-debug/schemas/investigation/evidence-gap-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "gapId", "caseId", "analysisId", "question", "status", "hypothesisIds", "predicateIds", "createdAt"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "gapId": { "$ref": "#/$defs/id" }, "caseId": { "$ref": "#/$defs/id" }, "analysisId": { "$ref": "#/$defs/id" },
    "question": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "status": { "enum": ["OPEN", "PLANNED", "OBSERVED", "UNRESOLVED", "CLOSED"] },
    "hypothesisIds": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "predicateIds": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "$defs": { "id": { "type": "string", "minLength": 1, "maxLength": 128 } }
}
