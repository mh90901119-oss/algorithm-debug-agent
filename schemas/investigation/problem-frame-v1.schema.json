{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/algorithm-debug/schemas/investigation/problem-frame-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "problemFrameId", "caseId", "analysisId", "symptom", "expectedBehavior", "actualBehavior", "targetTest", "scopeAnchors", "knownFactRefs", "initialUnknowns", "createdAt"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "problemFrameId": { "$ref": "#/$defs/id" },
    "caseId": { "$ref": "#/$defs/id" },
    "analysisId": { "$ref": "#/$defs/id" },
    "symptom": { "$ref": "#/$defs/text" },
    "expectedBehavior": { "$ref": "#/$defs/text" },
    "actualBehavior": { "$ref": "#/$defs/text" },
    "targetTest": { "$ref": "#/$defs/targetTest" },
    "scopeAnchors": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/sourceAnchor" } },
    "knownFactRefs": { "$ref": "#/$defs/stringRefs" },
    "initialUnknowns": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "text": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "stringRefs": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
    "targetTest": {
      "type": "object", "additionalProperties": false,
      "required": ["className", "methodName"],
      "properties": { "className": { "type": "string", "minLength": 3 }, "methodName": { "type": "string", "minLength": 1 } }
    },
    "sourceAnchor": {
      "type": "object", "additionalProperties": false,
      "required": ["className", "methodName", "descriptor", "sourceRelativePath", "startLine", "endLine"],
      "properties": {
        "className": { "type": "string", "minLength": 3 }, "methodName": { "type": "string", "minLength": 1 },
        "descriptor": { "type": "string", "minLength": 3 }, "sourceRelativePath": { "type": "string", "minLength": 1 },
        "startLine": { "type": "integer", "minimum": 1 }, "endLine": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
