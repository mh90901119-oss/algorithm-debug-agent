{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/algorithm-debug/schemas/investigation/investigation-binding-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "caseId", "analysisId", "gapId", "hypothesisIds", "predicateIds", "basedOnEvidenceIds"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "caseId": { "$ref": "#/$defs/id" }, "analysisId": { "$ref": "#/$defs/id" }, "gapId": { "$ref": "#/$defs/id" },
    "hypothesisIds": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "predicateIds": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "basedOnEvidenceIds": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
  },
  "$defs": { "id": { "type": "string", "minLength": 1, "maxLength": 128 } }
}
