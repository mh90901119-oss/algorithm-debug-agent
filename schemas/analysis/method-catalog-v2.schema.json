{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://algorithm-debug-agent.local/schemas/analysis/method-catalog-v2.schema.json",
    "type":  "object",
    "additionalProperties":  false,
    "required":  [
                     "schemaVersion",
                     "caseId",
                     "contextId",
                     "analysisId",
                     "targetTest",
                     "entries",
                     "edges",
                     "warnings",
                     "completeness",
                     "discoveredMethodCount",
                     "discoveredEdgeCount",
                     "createdAt"
                 ],
    "properties":  {
                       "schemaVersion":  {
                                             "const":  "2.0"
                                         },
                       "caseId":  {
                                      "type":  "string",
                                      "minLength":  1
                                  },
                       "contextId":  {
                                         "type":  "string",
                                         "minLength":  1
                                     },
                       "analysisId":  {
                                          "type":  "string",
                                          "minLength":  1
                                      },
                       "targetTest":  {
                                          "$ref":  "#/$defs/targetTest"
                                      },
                       "entries":  {
                                       "type":  "array",
                                       "minItems":  1,
                                       "maxItems":  50000,
                                       "items":  {
                                                     "$ref":  "#/$defs/entry"
                                                 }
                                   },
                       "edges":  {
                                     "type":  "array",
                                     "maxItems":  250000,
                                     "items":  {
                                                   "$ref":  "#/$defs/edge"
                                               }
                                 },
                       "warnings":  {
                                        "type":  "array",
                                        "maxItems":  1000,
                                        "items":  {
                                                      "type":  "string",
                                                      "maxLength":  2048
                                                  }
                                    },
                       "completeness":  {
                                            "enum":  [
                                                         "COMPLETE",
                                                         "INCOMPLETE"
                                                     ]
                                        },
                       "discoveredMethodCount":  {
                                                     "type":  "integer",
                                                     "minimum":  1
                                                 },
                       "discoveredEdgeCount":  {
                                                   "type":  "integer",
                                                   "minimum":  0
                                               },
                       "createdAt":  {
                                         "type":  "string",
                                         "format":  "date-time"
                                     }
                   },
    "$defs":  {
                  "targetTest":  {
                                     "type":  "object",
                                     "additionalProperties":  false,
                                     "required":  [
                                                      "className",
                                                      "methodName"
                                                  ],
                                     "properties":  {
                                                        "className":  {
                                                                          "type":  "string",
                                                                          "minLength":  1
                                                                      },
                                                        "methodName":  {
                                                                           "type":  "string",
                                                                           "minLength":  1
                                                                       }
                                                    }
                                 },
                  "sourceAnchor":  {
                                       "type":  "object",
                                       "additionalProperties":  false,
                                       "required":  [
                                                        "className",
                                                        "methodName",
                                                        "descriptor",
                                                        "sourceRelativePath",
                                                        "startLine",
                                                        "endLine"
                                                    ],
                                       "properties":  {
                                                          "className":  {
                                                                            "type":  "string",
                                                                            "minLength":  1
                                                                        },
                                                          "methodName":  {
                                                                             "type":  "string",
                                                                             "minLength":  1
                                                                         },
                                                          "descriptor":  {
                                                                             "type":  "string",
                                                                             "minLength":  3
                                                                         },
                                                          "sourceRelativePath":  {
                                                                                     "type":  "string",
                                                                                     "minLength":  1
                                                                                 },
                                                          "startLine":  {
                                                                            "type":  "integer",
                                                                            "minimum":  1
                                                                        },
                                                          "endLine":  {
                                                                          "type":  "integer",
                                                                          "minimum":  1
                                                                      }
                                                      }
                                   },
                  "entry":  {
                                "type":  "object",
                                "additionalProperties":  false,
                                "required":  [
                                                 "methodKey",
                                                 "sourceAnchor",
                                                 "distanceFromTarget",
                                                 "targetMethod"
                                             ],
                                "properties":  {
                                                   "methodKey":  {
                                                                     "type":  "string",
                                                                     "minLength":  1,
                                                                     "maxLength":  1024
                                                                 },
                                                   "sourceAnchor":  {
                                                                        "$ref":  "#/$defs/sourceAnchor"
                                                                    },
                                                   "distanceFromTarget":  {
                                                                              "type":  "integer",
                                                                              "minimum":  0
                                                                          },
                                                   "targetMethod":  {
                                                                        "type":  "boolean"
                                                                    }
                                               }
                            },
                  "edge":  {
                               "type":  "object",
                               "additionalProperties":  false,
                               "required":  [
                                                "callerKey",
                                                "calleeKey",
                                                "sourceLine"
                                            ],
                               "properties":  {
                                                  "callerKey":  {
                                                                    "type":  "string",
                                                                    "minLength":  1,
                                                                    "maxLength":  1024
                                                                },
                                                  "calleeKey":  {
                                                                    "type":  "string",
                                                                    "minLength":  1,
                                                                    "maxLength":  1024
                                                                },
                                                  "sourceLine":  {
                                                                     "type":  "integer",
                                                                     "minimum":  1
                                                                 },
                                                  "resolutionKind":  {
                                                                         "enum":  [
                                                                                      "DIRECT",
                                                                                      "POLYMORPHIC_CANDIDATE"
                                                                                  ]
                                                                 }
                                              }
                           }
              }
}
