{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://algorithm-debug-agent.local/schemas/analysis/method-catalog-v1.schema.json",
  "title": "MethodCatalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "caseId", "contextId", "analysisId", "targetTest",
    "sourceFingerprintSha256", "entries", "edges", "warnings", "packageCensus",
    "completeness", "packageCensusCompleteness", "discoveredMethodCount",
    "discoveredEdgeCount", "createdAt"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "caseId": { "$ref": "#/$defs/id" },
    "contextId": { "$ref": "#/$defs/id" },
    "analysisId": { "$ref": "#/$defs/id" },
    "targetTest": { "$ref": "#/$defs/targetTest" },
    "sourceFingerprintSha256": { "$ref": "#/$defs/sha256" },
    "entries": {
      "type": "array", "minItems": 1, "maxItems": 50000,
      "items": { "$ref": "#/$defs/entry" }
    },
    "edges": {
      "type": "array", "maxItems": 250000,
      "items": { "$ref": "#/$defs/edge" }
    },
    "warnings": {
      "type": "array", "maxItems": 1000,
      "items": { "type": "string", "minLength": 1, "maxLength": 2048 }
    },
    "packageCensus": {
      "type": "array", "minItems": 1, "maxItems": 50000,
      "items": { "$ref": "#/$defs/packageCensusEntry" }
    },
    "completeness": { "enum": ["COMPLETE", "INCOMPLETE"] },
    "packageCensusCompleteness": { "enum": ["COMPLETE", "INCOMPLETE"] },
    "discoveredMethodCount": { "type": "integer", "minimum": 1 },
    "discoveredEdgeCount": { "type": "integer", "minimum": 0 },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "targetTest": {
      "type": "object", "additionalProperties": false,
      "required": ["className", "methodName"],
      "properties": {
        "className": { "type": "string", "minLength": 3 },
        "methodName": { "type": "string", "minLength": 1 }
      }
    },
    "anchor": {
      "type": "object", "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "methodName": { "const": "<init>" } },
            "required": ["methodName"]
          },
          "then": {
            "properties": { "descriptor": { "pattern": "^.*\\)V$" } }
          }
        }
      ],
      "required": [
        "className", "methodName", "descriptor", "sourceRelativePath",
        "startLine", "endLine", "sourceSha256"
      ],
      "properties": {
        "className": { "type": "string", "minLength": 3 },
        "methodName": { "type": "string", "minLength": 1 },
        "descriptor": {
          "type": "string", "minLength": 3, "maxLength": 512,
          "pattern": "^\\((?:(?:[BCDFIJSZ]|\\[{1,255}(?:[BCDFIJSZ]|L[A-Za-z_$][A-Za-z0-9_$]*(?:/[A-Za-z_$][A-Za-z0-9_$]*)*;)|L[A-Za-z_$][A-Za-z0-9_$]*(?:/[A-Za-z_$][A-Za-z0-9_$]*)*;))*\\)(?:V|[BCDFIJSZ]|\\[{1,255}(?:[BCDFIJSZ]|L[A-Za-z_$][A-Za-z0-9_$]*(?:/[A-Za-z_$][A-Za-z0-9_$]*)*;)|L[A-Za-z_$][A-Za-z0-9_$]*(?:/[A-Za-z_$][A-Za-z0-9_$]*)*;)$"
        },
        "sourceRelativePath": { "$ref": "#/$defs/relativePath" },
        "startLine": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 },
        "sourceSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["methodKey", "sourceAnchor", "distanceFromTarget", "targetMethod"],
      "properties": {
        "methodKey": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "sourceAnchor": { "$ref": "#/$defs/anchor" },
        "distanceFromTarget": { "type": "integer", "minimum": 0 },
        "targetMethod": { "type": "boolean" }
      }
    },
    "packageCensusEntry": {
      "type": "object", "additionalProperties": false,
      "required": ["packageName", "methodCount"],
      "properties": {
        "packageName": {
          "type": "string", "minLength": 1, "maxLength": 512,
          "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*(\\.[A-Za-z_$][A-Za-z0-9_$]*)*$"
        },
        "methodCount": { "type": "integer", "minimum": 1 }
      }
    },
    "edge": {
      "type": "object", "additionalProperties": false,
      "required": ["callerKey", "calleeKey", "sourceLine"],
      "properties": {
        "callerKey": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "calleeKey": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "sourceLine": { "type": "integer", "minimum": 1 }
      }
    },
    "relativePath": {
      "type": "string", "minLength": 1,
      "pattern": "^(?!/)(?!.*:)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\).+$"
    }
  }
}
