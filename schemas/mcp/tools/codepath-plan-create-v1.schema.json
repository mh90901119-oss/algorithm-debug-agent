    "scopeCondition":{"type":"object","additionalProperties":false,"required":["projectionName","expectedType","expectedValue"],"properties":{"projectionName":{"type":"string","minLength":1,"maxLength":128},"expectedType":{"enum":["STRING","INTEGER","DECIMAL","BOOLEAN","NULL"]},"expectedValue":{"type":["string","number","boolean","null"]}}},
    "budget":{"type":"object","additionalProperties":false,"required":["maxEvents","maxBytes","timeoutMillis"],"properties":{"maxEvents":{"type":"integer","minimum":1,"maximum":1000000},"maxBytes":{"type":"integer","minimum":1,"maximum":52428800},"timeoutMillis":{"type":"integer","minimum":1,"maximum":1200000}}},
    "investigation":{"type":"object","additionalProperties":false,"required":["questionToAnswer","gapId","hypothesisIds","predicateIds","basedOnEvidenceIds"],"properties":{"questionToAnswer":{"type":"string","minLength":1,"maxLength":2048},"gapId":{"$ref":"#/$defs/id"},"hypothesisIds":{"type":"array","minItems":1,"maxItems":32,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"predicateIds":{"type":"array","minItems":1,"maxItems":8,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"basedOnEvidenceIds":{"type":"array","maxItems":128,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}}}}
  }
