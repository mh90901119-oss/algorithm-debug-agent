{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"CodePath plan create input","type":"object","additionalProperties":false,
  "required":["caseId","analysisId","request"],
  "properties":{"caseId":{"$ref":"#/$defs/id"},"analysisId":{"$ref":"#/$defs/id"},"request":{"type":"object","additionalProperties":false,
    "required":["planId","methods","rationale","investigation","budget","requestedAt"],
    "properties":{"planId":{"$ref":"#/$defs/id"},"methods":{"type":"array","minItems":1,"maxItems":50,"items":{"$ref":"#/$defs/method"}},"scopeMethodKey":{"type":["string","null"],"maxLength":2048},"scopeConditions":{"type":"array","maxItems":4,"items":{"$ref":"#/$defs/scopeCondition"}},"captureMode":{"enum":["TRACE","AGGREGATE"]},"scopeStartOrdinal":{"type":"integer","minimum":0,"maximum":1000000},"maxMatchedScopes":{"type":"integer","minimum":0,"maximum":10000},"rationale":{"type":"string","minLength":1,"maxLength":4096},"investigation":{"$ref":"#/$defs/investigation"},"budget":{"$ref":"#/$defs/budget"},"requestedAt":{"type":"string","format":"date-time"}}
  }},
  "$defs":{
