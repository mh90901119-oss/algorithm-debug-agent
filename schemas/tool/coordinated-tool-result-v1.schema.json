{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/algorithm-debug/schemas/tool/coordinated-tool-result-v1.schema.json",
  "title": "CoordinatedToolResult v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "outcome", "code", "message", "data", "artifacts", "control"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "outcome": { "enum": ["SUCCEEDED", "REJECTED", "FAILED"] },
    "code": { "type": "string", "minLength": 1, "maxLength": 128 },
    "message": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "data": {},
    "artifacts": {
      "type": "array", "maxItems": 64,
      "items": { "$ref": "#/$defs/artifactReference" }
    },
    "control": { "$ref": "#/$defs/control" }
  },
  "allOf": [
    {
      "if": { "properties": { "outcome": { "const": "REJECTED" } } },
      "then": {
        "properties": {
          "artifacts": { "maxItems": 0 },
          "control": {
            "allOf": [
              { "$ref": "#/$defs/control" },
              { "properties": { "decision": { "const": "REJECTED" } } }
            ]
          }
        }
      },
      "else": {
        "properties": {
          "control": {
            "allOf": [
              { "$ref": "#/$defs/control" },
              { "properties": { "decision": { "const": "ALLOWED" } } }
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "opaqueId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "idList": {
      "type": "array", "maxItems": 128, "uniqueItems": true,
      "items": { "$ref": "#/$defs/opaqueId" }
    },
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["projectId", "caseId", "analysisId"],
      "properties": {
        "projectId": { "$ref": "#/$defs/opaqueId" },
        "caseId": { "$ref": "#/$defs/opaqueId" },
        "analysisId": { "$ref": "#/$defs/opaqueId" }
      }
    },
    "actionType": {
      "type": "string",
      "enum": [
        "ANALYSIS_BEGIN", "CASE_INSPECT", "ALGORITHM_INPUT_CAPTURE", "CASE_AUDIT",
        "GANTT_INSPECT", "RUN_TEST", "STATIC_ANALYZE", "SOURCE_QUERY",
        "INVESTIGATION_UPDATE", "CODEPATH_PLAN_CREATE", "CODEPATH_COLLECT",
        "JDWP_PLAN_CREATE", "JDWP_COLLECT", "ARTIFACT_READ", "EVIDENCE_QUERY",
        "ANALYSIS_STATUS", "ANALYSIS_FINALIZE"
      ]
    },
    "errorCodes": {
      "type": "array", "maxItems": 128, "uniqueItems": true,
      "items": {
        "enum": [
          "COORDINATION_IDENTITY_MISMATCH", "COORDINATION_ACTION_NOT_ALLOWED",
          "COORDINATION_STATE_INVALID", "COORDINATION_PREREQUISITE_MISSING",
          "COORDINATION_POSTCONDITION_FAILED", "ACTION_EXECUTION_FAILED", "ACTION_CANCELLED",
          "ACTION_OPERATION_ID_REQUIRED",
          "TARGET_EXECUTION_BUSY", "OPERATION_IN_PROGRESS", "OPERATION_UNCERTAIN",
          "OPERATION_JOURNAL_CONFLICT", "CONCLUSION_NOT_ELIGIBLE"
        ]
      }
    },
    "artifactReference": {
      "type": "object", "additionalProperties": false,
      "required": ["artifactId", "artifactType", "relativePath", "mediaType", "sha256", "sizeBytes"],
      "properties": {
        "artifactId": { "$ref": "#/$defs/opaqueId" },
        "artifactType": { "type": "string", "minLength": 1 },
        "relativePath": { "type": "string", "minLength": 1 },
        "mediaType": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "sizeBytes": { "type": "integer", "minimum": 0 }
      }
    },
    "control": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schemaVersion", "policyVersion", "identity", "revision", "requestedAction",
        "decision", "reasonCodes", "satisfiedObligationIds", "remainingObligationIds",
        "contradictionIds", "openGapIds", "supportedHypothesisIds", "refutedHypothesisIds",
        "unevaluatedPredicateIds", "allowedActions", "terminalEligibility"
      ],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "policyVersion": { "type": "string", "minLength": 1, "maxLength": 32 },
        "identity": { "$ref": "#/$defs/identity" },
        "revision": { "type": "integer", "minimum": 0 },
        "requestedAction": { "$ref": "#/$defs/actionType" },
        "decision": { "enum": ["ALLOWED", "REJECTED"] },
        "reasonCodes": { "$ref": "#/$defs/errorCodes" },
        "satisfiedObligationIds": { "$ref": "#/$defs/idList" },
        "remainingObligationIds": { "$ref": "#/$defs/idList" },
        "contradictionIds": { "$ref": "#/$defs/idList" },
        "openGapIds": { "$ref": "#/$defs/idList" },
        "supportedHypothesisIds": { "$ref": "#/$defs/idList" },
        "refutedHypothesisIds": { "$ref": "#/$defs/idList" },
        "unevaluatedPredicateIds": { "$ref": "#/$defs/idList" },
        "allowedActions": {
          "type": "array", "maxItems": 128, "uniqueItems": true,
          "items": { "$ref": "#/$defs/actionType" }
        },
        "terminalEligibility": {
          "enum": ["CONFIRMED", "BOUNDED_HYPOTHESIS", "MISSING_EVIDENCE"]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "decision": { "const": "ALLOWED" } } },
          "then": { "properties": { "reasonCodes": { "maxItems": 0 } } },
          "else": { "properties": { "reasonCodes": { "minItems": 1 } } }
        }
      ]
    }
  }
}
