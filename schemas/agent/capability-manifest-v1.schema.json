{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://algorithm-debug-agent.local/schemas/capability-manifest-v1.schema.json",
  "title": "Algorithm Debug MCP Capability Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "serverId", "transport", "tools", "resources", "prompts"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "serverId": { "const": "algorithm-debug" },
    "transport": { "const": "stdio" },
    "tools": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 256 }
    },
    "prompts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    }
  }
}
