{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://algorithm-debug-agent.local/schemas/algorithm-debug-agent-v1.schema.json",
  "title": "Algorithm Debug Agent Definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profileVersion",
    "agentId",
    "description",
    "inputContract",
    "requiredMcpServer",
    "requiredCapabilities",
    "allowedToolGroups",
    "prompt",
    "completionContract",
    "capabilityManifest",
    "knowledge",
    "defaultModelHints"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1, "maxLength": 256 },
    "profileVersion": { "const": "1.0" },
    "agentId": { "const": "algorithm-debug" },
    "description": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "inputContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "requiredFields"],
      "properties": {
        "scope": { "const": "one-java-maven-junit-test" },
        "requiredFields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["problem", "projectRoot", "testClass", "testMethod"] }
        }
      }
    },
    "requiredMcpServer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["serverId", "transport"],
      "properties": {
        "serverId": { "const": "algorithm-debug" },
        "transport": { "const": "stdio" }
      }
    },
    "requiredCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tools", "resources", "prompts"],
      "properties": {
        "tools": { "type": "boolean", "const": true },
        "resources": { "type": "boolean", "const": true },
        "prompts": { "type": "boolean", "const": true }
      }
    },
    "allowedToolGroups": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["groupId", "serverId", "toolNames"],
        "properties": {
          "groupId": { "type": "string", "minLength": 1, "maxLength": 64 },
          "serverId": { "const": "algorithm-debug" },
          "toolNames": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
          }
        }
      }
    },
    "prompt": { "$ref": "#/$defs/hashedAsset" },
    "completionContract": { "$ref": "#/$defs/hashedAsset" },
    "capabilityManifest": { "$ref": "#/$defs/hashedAsset" },
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "role"],
      "properties": {
        "required": { "const": false },
        "role": { "const": "KNOWLEDGE_HINT" }
      }
    },
    "defaultModelHints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "temperature": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  },
  "$defs": {
    "hashedAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "version", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$"
        },
        "version": { "type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+$" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
