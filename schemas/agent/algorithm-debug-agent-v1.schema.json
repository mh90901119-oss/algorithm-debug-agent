{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://algorithm-debug-agent.local/schemas/algorithm-debug-agent-v1.schema.json",
  "title": "Algorithm Debug Agent Definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profileVersion",
    "agentId",
    "description",
    "inputContract",
    "requiredMcpServer",
    "requiredCapabilities",
    "prompt",
    "capabilityManifest",
    "knowledge"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1, "maxLength": 256 },
    "profileVersion": { "const": "2.0" },
    "agentId": { "const": "algorithm-debug" },
    "description": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "inputContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "requiredFields"],
      "properties": {
        "scope": { "const": "one-java-maven-junit-test" },
        "requiredFields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["problem", "projectRoot", "testClass", "testMethod"] }
        }
      }
    },
    "requiredMcpServer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["serverId", "transport"],
      "properties": {
        "serverId": { "const": "algorithm-debug" },
        "transport": { "const": "stdio" }
      }
    },
    "requiredCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tools"],
      "properties": {
        "tools": { "type": "boolean", "const": true }
      }
    },
    "prompt": { "$ref": "#/$defs/hashedAsset" },
    "capabilityManifest": { "$ref": "#/$defs/hashedAsset" },
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "role", "delivery", "limits"],
      "properties": {
        "required": { "const": false },
        "role": { "const": "KNOWLEDGE_HINT" },
        "delivery": { "const": "PROMPT_APPEND" },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxFiles", "maxDepth", "maxFileBytes", "maxTotalBytes"],
          "properties": {
            "maxFiles": { "type": "integer", "minimum": 1, "maximum": 64 },
            "maxDepth": { "type": "integer", "minimum": 0, "maximum": 8 },
            "maxFileBytes": { "type": "integer", "minimum": 1, "maximum": 262144 },
            "maxTotalBytes": { "type": "integer", "minimum": 1, "maximum": 1048576 }
          }
        }
      }
    }
  },
  "$defs": {
    "hashedAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "version", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$"
        },
        "version": { "type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+$" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
