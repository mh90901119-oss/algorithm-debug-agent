{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://algorithm-debug-agent/schemas/config/agent-settings-v1.schema.json",
  "title": "Algorithm Debug Agent Settings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "openCodeConfigDirectory",
    "workspaceDirectory",
    "dfxDirectory",
    "evalDirectory",
    "resultJsonDirectory",
    "agentJavaHome",
    "targetJavaHome",
    "mavenExecutable",
    "dfxEnabled"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "openCodeConfigDirectory": { "type": "string", "minLength": 1 },
    "workspaceDirectory": { "type": "string", "minLength": 1 },
    "dfxDirectory": { "type": "string", "minLength": 1 },
    "evalDirectory": { "type": "string", "minLength": 1 },
    "resultJsonDirectory": { "type": "string", "minLength": 1 },
    "agentJavaHome": { "type": "string" },
    "targetJavaHome": { "type": "string" },
    "mavenExecutable": { "type": "string" },
    "dfxEnabled": { "type": "boolean" }
  }
}
