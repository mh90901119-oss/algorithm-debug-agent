{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://algorithm-debug-agent.local/schema/gantt-inspection-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "caseId", "artifactId", "operation", "jsonPointer", "nodeType", "totalItems", "offset", "returnedItems", "truncated", "fields", "json"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "caseId": {"type": "string"},
    "artifactId": {"type": "string"},
    "operation": {"enum": ["summary", "slice"]},
    "jsonPointer": {"type": "string"},
    "nodeType": {"type": "string"},
    "totalItems": {"type": "integer", "minimum": 0},
    "offset": {"type": "integer", "minimum": 0},
    "returnedItems": {"type": "integer", "minimum": 0, "maximum": 100},
    "truncated": {"type": "boolean"},
    "fields": {"type": "array", "items": {"type": "string"}},
    "json": {"type": "string", "maxLength": 1048576}
  }
}
