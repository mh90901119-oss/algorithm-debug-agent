{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://algorithm-debug-agent.local/schemas/collection/collection-baseline-check-v1.schema.json",
  "title": "Collection Baseline Check v1", "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "caseId", "contextId", "analysisId", "runId", "collectionId", "outcome", "referenceRunId", "currentGanttSha256", "evidenceUsable", "summary", "checkedAt"],
  "properties": {
    "schemaVersion": {"const": "1.0"}, "caseId": {"type": "string"}, "contextId": {"type": "string"}, "analysisId": {"type": "string"}, "runId": {"type": "string"}, "collectionId": {"type": "string"},
    "outcome": {"enum": ["MATCHED", "CHANGED", "INCOMPARABLE", "NOT_COMPARED"]}, "referenceRunId": {"type": ["string", "null"]}, "currentGanttSha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "evidenceUsable": {"type": "boolean"}, "summary": {"type": "string", "maxLength": 2048}, "checkedAt": {"type": "string", "format": "date-time"}
  }
}
