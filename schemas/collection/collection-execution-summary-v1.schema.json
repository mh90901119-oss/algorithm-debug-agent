{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://algorithm-debug-agent.local/schemas/collection/collection-execution-summary-v1.schema.json",
  "title": "Collection Execution Summary v1", "type": "object", "additionalProperties": false,
  "required": ["caseId", "contextId", "analysisId", "runId", "planId", "collectionId", "completion", "baselineOutcome", "evidenceUsable", "artifactRelativePaths"],
  "properties": {
    "caseId": {"type": "string"}, "contextId": {"type": "string"}, "analysisId": {"type": "string"}, "runId": {"type": "string"}, "planId": {"type": "string"}, "collectionId": {"type": "string"},
    "completion": {"type": "string", "maxLength": 64}, "baselineOutcome": {"enum": ["MATCHED", "CHANGED", "INCOMPARABLE", "NOT_COMPARED"]}, "evidenceUsable": {"type": "boolean"},
    "artifactRelativePaths": {"type": "array", "maxItems": 32, "items": {"type": "string", "maxLength": 1024}}
  }
}
