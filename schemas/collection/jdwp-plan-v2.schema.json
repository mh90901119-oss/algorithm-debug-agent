{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://algorithm-debug-agent.local/schemas/collection/jdwp-plan-v2.schema.json",
    "type":  "object",
    "additionalProperties":  false,
    "required":  [
                     "schemaVersion",
                     "planId",
                     "caseId",
                     "contextId",
                     "analysisId",
                     "targetTest",
                     "tracepoints",
                     "budget",
                     "rationale",
                     "createdAt"
                 ],
    "properties":  {
                       "schemaVersion":  {
                                             "const":  "2.0"
                                         },
                       "planId":  {
                                      "type":  "string",
                                      "minLength":  1
                                  },
                       "caseId":  {
                                      "type":  "string",
                                      "minLength":  1
                                  },
                       "contextId":  {
                                         "type":  "string",
                                         "minLength":  1
                                     },
                       "analysisId":  {
                                          "type":  "string",
                                          "minLength":  1
                                      },
                       "targetTest":  {
                                          "$ref":  "#/$defs/targetTest"
                                      },
                       "tracepoints":  {
                                           "type":  "array",
                                           "minItems":  1,
                                           "maxItems":  20,
                                           "items":  {
                                                         "$ref":  "#/$defs/tracepoint"
                                                     }
                                       },
                       "budget":  {
                                      "$ref":  "#/$defs/budget"
                                  },
                       "rationale":  {
                                         "type":  "string",
                                         "minLength":  1,
                                         "maxLength":  4096
                                     },
                       "createdAt":  {
                                         "type":  "string",
                                         "format":  "date-time"
                                     }
                   },
    "$defs":  {
                  "targetTest":  {
                                     "type":  "object",
                                     "additionalProperties":  false,
                                     "required":  [
                                                      "className",
                                                      "methodName"
                                                  ],
                                     "properties":  {
                                                        "className":  {
                                                                          "type":  "string",
                                                                          "minLength":  1
                                                                      },
                                                        "methodName":  {
                                                                           "type":  "string",
                                                                           "minLength":  1
                                                                       }
                                                    }
                                 },
                  "sourceAnchor":  {
                                       "type":  "object",
                                       "additionalProperties":  false,
                                       "required":  [
                                                        "className",
                                                        "methodName",
                                                        "descriptor",
                                                        "sourceRelativePath",
                                                        "startLine",
                                                        "endLine"
                                                    ],
                                       "properties":  {
                                                          "className":  {
                                                                            "type":  "string",
                                                                            "minLength":  1
                                                                        },
                                                          "methodName":  {
                                                                             "type":  "string",
                                                                             "minLength":  1
                                                                         },
                                                          "descriptor":  {
                                                                             "type":  "string",
                                                                             "minLength":  3
                                                                         },
                                                          "sourceRelativePath":  {
                                                                                     "type":  "string",
                                                                                     "minLength":  1
                                                                                 },
                                                          "startLine":  {
                                                                            "type":  "integer",
                                                                            "minimum":  1
                                                                        },
                                                          "endLine":  {
                                                                          "type":  "integer",
                                                                          "minimum":  1
                                                                      }
                                                      }
                                   },
                  "tracepoint":  {
                                     "type":  "object",
                                     "additionalProperties":  false,
                                     "required":  [
                                                      "tracepointId",
                                                      "methodKey",
                                                      "sourceAnchor",
                                                      "line",
                                                      "maxHits",
                                                      "capture"
                                                  ],
                                     "properties":  {
                                                        "tracepointId":  {
                                                                             "type":  "string",
                                                                             "minLength":  1
                                                                         },
                                                        "methodKey":  {
                                                                          "type":  "string",
                                                                          "minLength":  1,
                                                                          "maxLength":  1024
                                                                      },
                                                        "sourceAnchor":  {
                                                                             "$ref":  "#/$defs/sourceAnchor"
                                                                         },
                                                        "line":  {
                                                                     "type":  "integer",
                                                                     "minimum":  1
                                                                 },
                                                        "maxHits":  {
                                                                        "type":  "integer",
                                                                        "minimum":  1,
                                                                        "maximum":  20
                                                                    },
                                                        "capture":  {
                                                                        "$ref":  "#/$defs/capture"
                                                                    }
                                                    }
                                 },
                  "capture":  {
                                  "type":  "object",
                                  "additionalProperties":  false,
                                  "required":  [
                                                   "locals",
                                                   "stack",
                                                   "maxFrames",
                                                   "maxDepth",
                                                   "maxItems",
                                                   "maxStringLength"
                                               ],
                                  "properties":  {
                                                     "locals":  {
                                                                    "type":  "boolean"
                                                                },
                                                     "stack":  {
                                                                   "type":  "boolean"
                                                               },
                                                     "maxFrames":  {
                                                                       "type":  "integer",
                                                                       "minimum":  1,
                                                                       "maximum":  64
                                                                   },
                                                     "maxDepth":  {
                                                                      "type":  "integer",
                                                                      "minimum":  0,
                                                                      "maximum":  2
                                                                  },
                                                     "maxItems":  {
                                                                      "type":  "integer",
                                                                      "minimum":  1,
                                                                      "maximum":  100
                                                                  },
                                                     "maxStringLength":  {
                                                                             "type":  "integer",
                                                                             "minimum":  16,
                                                                             "maximum":  1024
                                                                         },
                                                     "localNames":  {
                                                                        "type":  "array",
                                                                        "maxItems":  64,
                                                                        "uniqueItems":  true,
                                                                        "items":  {
                                                                                      "type":  "string",
                                                                                      "minLength":  1,
                                                                                      "maxLength":  256
                                                                                  }
                                                                    },
                                                     "fieldPaths":  {
                                                                        "type":  "array",
                                                                        "maxItems":  128,
                                                                        "uniqueItems":  true,
                                                                        "items":  {
                                                                                      "type":  "string",
                                                                                      "minLength":  1,
                                                                                      "maxLength":  2048
                                                                                  }
                                                                    }
                                                 }
                              },
                  "budget":  {
                                 "type":  "object",
                                 "additionalProperties":  false,
                                 "required":  [
                                                  "maxEvents",
                                                  "maxBytes",
                                                  "timeoutMillis",
                                                  "idleTimeoutMillis"
                                              ],
                                 "properties":  {
                                                    "maxEvents":  {
                                                                      "type":  "integer",
                                                                      "minimum":  1,
                                                                      "maximum":  1000
                                                                  },
                                                    "maxBytes":  {
                                                                     "type":  "integer",
                                                                     "minimum":  1,
                                                                     "maximum":  52428800
                                                                 },
                                                    "timeoutMillis":  {
                                                                          "type":  "integer",
                                                                          "minimum":  1000,
                                                                          "maximum":  1200000
                                                                      },
                                                    "idleTimeoutMillis":  {
                                                                              "type":  "integer",
                                                                              "minimum":  1000,
                                                                              "maximum":  1200000
                                                                          }
                                                }
                             }
              }
}
