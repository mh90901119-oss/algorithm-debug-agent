{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://algorithm-debug-agent.local/schemas/collection/method-path-collection-request-v2.schema.json",
  "title": "Method Path Collection Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "caseId",
    "analysisId",
    "runId",
    "planId",
    "collectionId",
    "targetTest",
    "collectorType",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0"
    },
    "caseId": {
      "type": "string"
    },
    "analysisId": {
      "type": "string"
    },
    "runId": {
      "type": "string"
    },
    "planId": {
      "type": "string"
    },
    "collectionId": {
      "type": "string"
    },
    "targetTest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "className",
        "methodName"
      ],
      "properties": {
        "className": {
          "type": "string"
        },
        "methodName": {
          "type": "string"
        }
      }
    },
    "collectorType": {
      "const": "CODEPATH"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
