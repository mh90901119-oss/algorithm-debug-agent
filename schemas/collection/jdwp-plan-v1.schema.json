{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://algorithm-debug-agent.local/schemas/collection/jdwp-plan-v1.schema.json",
  "title": "JDWP Collection Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "planId", "caseId", "contextId", "analysisId", "targetTest", "sourceFingerprintSha256", "tracepoints", "budget", "rationale", "createdAt"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "planId": {"type": "string", "minLength": 1, "maxLength": 128},
    "caseId": {"type": "string", "minLength": 1, "maxLength": 128},
    "contextId": {"type": "string", "minLength": 1, "maxLength": 128},
    "analysisId": {"type": "string", "minLength": 1, "maxLength": 128},
    "targetTest": {"$ref": "#/$defs/targetTest"},
    "sourceFingerprintSha256": {"$ref": "#/$defs/sha256"},
    "tracepoints": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"$ref": "#/$defs/tracepoint"}},
    "budget": {"$ref": "#/$defs/budget"},
    "rationale": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^\\S(?:[\\s\\S]*\\S)?$"},
    "createdAt": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "targetTest": {
      "type": "object", "additionalProperties": false,
      "required": ["className", "methodName"],
      "properties": {
        "className": {"type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*(\\.[A-Za-z_$][A-Za-z0-9_$]*)+$"},
        "methodName": {"type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"}
      }
    },
    "sourceAnchor": {
      "type": "object", "additionalProperties": false,
      "required": ["className", "methodName", "descriptor", "sourceRelativePath", "startLine", "endLine", "sourceSha256"],
      "properties": {
        "className": {"type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*(\\.[A-Za-z_$][A-Za-z0-9_$]*)+$"},
        "methodName": {"type": "string", "pattern": "^(<init>|[A-Za-z_$][A-Za-z0-9_$]*)$"},
        "descriptor": {"type": "string", "minLength": 3, "maxLength": 512},
        "sourceRelativePath": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[:\\\\]).+$"},
        "startLine": {"type": "integer", "minimum": 1},
        "endLine": {"type": "integer", "minimum": 1},
        "sourceSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "capture": {
      "type": "object", "additionalProperties": false,
      "required": ["locals", "stack", "maxFrames", "maxDepth", "maxItems", "maxStringLength"],
      "properties": {
        "locals": {"type": "boolean"},
        "stack": {"type": "boolean"},
        "maxFrames": {"type": "integer", "minimum": 1, "maximum": 64},
        "maxDepth": {"type": "integer", "minimum": 0, "maximum": 2},
        "maxItems": {"type": "integer", "minimum": 1, "maximum": 100},
        "maxStringLength": {"type": "integer", "minimum": 16, "maximum": 1024}
      },
      "anyOf": [
        {"properties": {"locals": {"const": true}}},
        {"properties": {"stack": {"const": true}}}
      ]
    },
    "tracepoint": {
      "type": "object", "additionalProperties": false,
      "required": ["tracepointId", "methodKey", "sourceAnchor", "line", "maxHits", "capture"],
      "properties": {
        "tracepointId": {"type": "string", "minLength": 1, "maxLength": 128},
        "methodKey": {"type": "string", "minLength": 1, "maxLength": 1024},
        "sourceAnchor": {"$ref": "#/$defs/sourceAnchor"},
        "line": {"type": "integer", "minimum": 1},
        "maxHits": {"type": "integer", "minimum": 1, "maximum": 20},
        "capture": {"$ref": "#/$defs/capture"}
      }
    },
    "budget": {
      "type": "object", "additionalProperties": false,
      "required": ["maxEvents", "maxBytes", "timeoutMillis", "idleTimeoutMillis"],
      "properties": {
        "maxEvents": {"type": "integer", "minimum": 1, "maximum": 1000},
        "maxBytes": {"type": "integer", "minimum": 1, "maximum": 52428800},
        "timeoutMillis": {"type": "integer", "minimum": 1000, "maximum": 1200000},
        "idleTimeoutMillis": {"type": "integer", "minimum": 1000, "maximum": 1200000}
      }
    }
  }
}
