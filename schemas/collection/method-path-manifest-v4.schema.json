{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://algorithm-debug-agent.local/schemas/collection/method-path-manifest-v4.schema.json",
  "title": "Method Path Manifest v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "caseId", "analysisId", "runId", "planId", "collectionId",
    "toolName", "toolVersion", "completion", "stage", "processStarted", "exitCode",
    "timedOut", "targetOutcome", "testsFound", "testsSucceeded", "testsAborted",
    "testsFailed", "capturedEventCount", "capturedBytes", "scopeFilter",
    "truncationReasons", "agentFailure", "rawTrace", "stdoutLog", "stderrLog",
    "startedAt", "completedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "4.0" },
    "caseId": { "type": "string" },
    "analysisId": { "type": "string" },
    "runId": { "type": "string" },
    "planId": { "type": "string" },
    "collectionId": { "type": "string" },
    "toolName": { "type": "string", "minLength": 1, "maxLength": 128 },
    "toolVersion": { "type": "string", "minLength": 1, "maxLength": 256 },
    "completion": { "enum": ["SUCCESS", "TARGET_FAILED", "TOOL_FAILED", "AGENT_FAILED", "TIMED_OUT", "TRUNCATED"] },
    "stage": { "enum": ["REQUEST_ARCHIVED", "CLASSPATH_RESOLVED", "PROCESS_COMPLETED", "COMPLETE", "FAILED"] },
    "processStarted": { "type": "boolean" },
    "exitCode": { "type": "integer" },
    "timedOut": { "type": "boolean" },
    "targetOutcome": { "enum": ["PASSED", "FAILED", "NOT_EXECUTED"] },
    "testsFound": { "type": "integer", "minimum": 0 },
    "testsSucceeded": { "type": "integer", "minimum": 0 },
    "testsAborted": { "type": "integer", "minimum": 0 },
    "testsFailed": { "type": "integer", "minimum": 0 },
    "capturedEventCount": { "type": "integer", "minimum": 0 },
    "capturedBytes": { "type": "integer", "minimum": 0 },
    "scopeFilter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "observedInvocations", "matchedInvocations", "unavailableConditionInvocations"],
      "properties": {
        "enabled": { "type": "boolean" },
        "observedInvocations": { "type": "integer", "minimum": 0 },
        "matchedInvocations": { "type": "integer", "minimum": 0 },
        "unavailableConditionInvocations": { "type": "integer", "minimum": 0 }
      }
    },
    "truncationReasons": {
      "type": "array", "maxItems": 16,
      "items": { "type": "string", "minLength": 1, "maxLength": 2048 }
    },
    "agentFailure": {
      "oneOf": [
        { "$ref": "#/$defs/agentFailure" },
        { "type": "null" }
      ]
    },
    "rawTrace": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "stdoutLog": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "stderrLog": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "agentFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "exceptionClass"],
      "properties": {
        "code": { "type": "string", "minLength": 1, "maxLength": 256 },
        "message": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "exceptionClass": { "type": "string", "maxLength": 1024 }
      }
    }
  }
}
