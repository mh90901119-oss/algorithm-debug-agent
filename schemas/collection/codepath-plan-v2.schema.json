{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://algorithm-debug-agent.local/schemas/collection/codepath-plan-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "planId", "caseId", "contextId", "analysisId", "targetTest", "selectors", "budget", "rationale", "createdAt"],
  "properties": {
    "schemaVersion": {"const": "2.0"},
    "planId": {"type": "string", "minLength": 1}, "caseId": {"type": "string", "minLength": 1},
    "contextId": {"type": "string", "minLength": 1}, "analysisId": {"type": "string", "minLength": 1},
    "targetTest": {"$ref": "#/$defs/targetTest"},
    "selectors": {"type": "array", "minItems": 1, "maxItems": 50, "items": {"$ref": "#/$defs/selector"}},
    "scopeMethodKey": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 2048}, {"type": "null"}]},
    "budget": {"$ref": "#/$defs/budget"},
    "rationale": {"type": "string", "minLength": 1, "maxLength": 4096},
    "createdAt": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "targetTest": {
      "type": "object", "additionalProperties": false,
      "required": ["className", "methodName"],
      "properties": {
        "className": {"type": "string", "minLength": 1},
        "methodName": {"type": "string", "minLength": 1}
      }
    },
    "selector": {
      "type": "object", "additionalProperties": false,
      "required": ["methodKey", "className", "methodName", "descriptor"],
      "properties": {
        "methodKey": {"type": "string", "minLength": 1, "maxLength": 1024},
        "className": {"type": "string", "minLength": 1},
        "methodName": {"type": "string", "minLength": 1},
        "descriptor": {"type": "string", "minLength": 3}
      }
    },
    "budget": {
      "type": "object", "additionalProperties": false,
      "required": ["maxEvents", "maxBytes", "timeoutMillis"],
      "properties": {
        "maxEvents": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "maxBytes": {"type": "integer", "minimum": 1, "maximum": 52428800},
        "timeoutMillis": {"type": "integer", "minimum": 1, "maximum": 1200000}
      }
    }
  }
}
