{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://algorithm-debug-agent.local/schemas/collection/method-path-manifest-v1.schema.json",
  "title": "Method Path Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "caseId", "contextId", "analysisId", "runId", "planId", "collectionId", "toolName", "toolVersion", "toolSha256", "planSha256", "captureScope", "evidenceScope", "matchPrecision", "packagePrefixes", "completion", "stage", "processStarted", "exitCode", "timedOut", "rawEventCount", "retainedEventCount", "exactDescriptorMatchCount", "degradedClassMethodMatchCount", "rawBytes", "filteredBytes", "rawSha256", "filteredSha256", "truncationReasons", "agentFailure", "stdoutLog", "stderrLog", "startedAt", "completedAt"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "caseId": {"type": "string"}, "contextId": {"type": "string"},
    "analysisId": {"type": "string"}, "runId": {"type": "string"},
    "planId": {"type": "string"}, "collectionId": {"type": "string"},
    "toolName": {"type": "string", "maxLength": 128},
    "toolVersion": {"type": "string", "maxLength": 256},
    "toolSha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "planSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "captureScope": {"const": "PACKAGE_SUPERSET"},
    "evidenceScope": {"const": "METHOD_ALLOWLIST"},
    "matchPrecision": {"enum": ["EXACT_DESCRIPTOR", "CLASS_METHOD_SUPERSET", "NONE"]},
    "packagePrefixes": {"type": "array", "minItems": 1, "maxItems": 200, "items": {"type": "string"}},
    "completion": {"enum": ["SUCCESS", "TRUNCATED", "TARGET_FAILED", "TOOL_FAILED", "TIMED_OUT", "AGENT_FAILED"]},
    "stage": {"enum": ["REQUEST_ARCHIVED", "SOURCE_VALIDATED", "CLASSPATH_RESOLVED", "PROCESS_COMPLETED", "RAW_VALIDATED", "FILTERED", "COMPLETE", "FAILED"]},
    "processStarted": {"type": "boolean"}, "exitCode": {"type": "integer"},
    "timedOut": {"type": "boolean"},
    "rawEventCount": {"type": "integer", "minimum": 0},
    "retainedEventCount": {"type": "integer", "minimum": 0},
    "exactDescriptorMatchCount": {"type": "integer", "minimum": 0},
    "degradedClassMethodMatchCount": {"type": "integer", "minimum": 0},
    "rawBytes": {"type": "integer", "minimum": 0},
    "filteredBytes": {"type": "integer", "minimum": 0},
    "rawSha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "filteredSha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "truncationReasons": {"type": "array", "maxItems": 16, "items": {"type": "string", "maxLength": 2048}},
    "agentFailure": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false,
         "required": ["code", "message", "exceptionClass"],
         "properties": {"code": {"type": "string"}, "message": {"type": "string"}, "exceptionClass": {"type": "string"}}}
      ]
    },
    "stdoutLog": {"type": "string", "maxLength": 1024},
    "stderrLog": {"type": "string", "maxLength": 1024},
    "startedAt": {"type": "string", "format": "date-time"},
    "completedAt": {"type": "string", "format": "date-time"}
  }
}
