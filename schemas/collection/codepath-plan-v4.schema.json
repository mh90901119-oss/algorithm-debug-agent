{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://algorithm-debug-agent.local/schemas/collection/codepath-plan-v4.schema.json",
    "type":  "object",
    "additionalProperties":  false,
    "required":  [
                     "schemaVersion",
                     "planId",
                     "caseId",
                     "analysisId",
                     "targetTest",
                     "methodSelections",
                     "budget",
                     "rationale",
                     "createdAt",
                     "intent"
                 ],
    "properties":  {
                       "schemaVersion":  {
                                             "const":  "4.0"
                                         },
                       "planId":  {
                                      "type":  "string",
                                      "minLength":  1
                                  },
                       "caseId":  {
                                      "type":  "string",
                                      "minLength":  1
                                  },
                       "analysisId":  {
                                          "type":  "string",
                                          "minLength":  1
                                      },
                       "targetTest":  {
                                          "$ref":  "#/$defs/targetTest"
                                      },
                       "scopeMethodKey":  {
                                              "oneOf":  [
                                                            {
                                                                "type":  "string",
                                                                "minLength":  1,
                                                                "maxLength":  2048
                                                            },
                                                            {
                                                                "type":  "null"
                                                            }
                                                        ]
                                          },
                       "budget":  {
                                      "$ref":  "#/$defs/budget"
                                  },
                       "rationale":  {
                                         "type":  "string",
                                         "minLength":  1,
                                         "maxLength":  4096
                                     },
                       "intent":  {
                                      "$ref":  "#/$defs/intent"
                                  },
                       "createdAt":  {
                                         "type":  "string",
                                         "format":  "date-time"
                                     },
                       "methodSelections":  {
                                                "type":  "array",
                                                "minItems":  1,
                                                "maxItems":  50,
                                                "items":  {
                                                              "type":  "object",
                                                              "additionalProperties":  false,
                                                              "required":  [
                                                                               "selector",
                                                                               "projections"
                                                                           ],
                                                              "properties":  {
                                                                                 "selector":  {
                                                                                                  "type":  "object",
                                                                                                  "additionalProperties":  false,
                                                                                                  "required":  [
                                                                                                                   "methodKey",
                                                                                                                   "className",
                                                                                                                   "methodName",
                                                                                                                   "descriptor"
                                                                                                               ],
                                                                                                  "properties":  {
                                                                                                                     "methodKey":  {
                                                                                                                                       "type":  "string",
                                                                                                                                       "minLength":  1,
                                                                                                                                       "maxLength":  2048
                                                                                                                                   },
                                                                                                                     "className":  {
                                                                                                                                       "type":  "string",
                                                                                                                                       "minLength":  1,
                                                                                                                                       "maxLength":  1024
                                                                                                                                   },
                                                                                                                     "methodName":  {
                                                                                                                                        "type":  "string",
                                                                                                                                        "minLength":  1,
                                                                                                                                        "maxLength":  512
                                                                                                                                    },
                                                                                                                     "descriptor":  {
                                                                                                                                        "type":  "string",
                                                                                                                                        "minLength":  3,
                                                                                                                                        "maxLength":  2048
                                                                                                                                    }
                                                                                                                 }
                                                                                              },
                                                                                 "projections":  {
                                                                                                     "type":  "array",
                                                                                                     "maxItems":  32,
                                                                                                     "items":  {
                                                                                                                   "type":  "object",
                                                                                                                   "additionalProperties":  false,
                                                                                                                   "required":  [
                                                                                                                                    "name",
                                                                                                                                    "source",
                                                                                                                                    "argumentIndex",
                                                                                                                                    "fieldPath",
                                                                                                                                    "required"
                                                                                                                                ],
                                                                                                                   "properties":  {
                                                                                                                                      "name":  {
                                                                                                                                                   "type":  "string",
                                                                                                                                                   "minLength":  1,
                                                                                                                                                   "maxLength":  128
                                                                                                                                               },
                                                                                                                                      "source":  {
                                                                                                                                                     "type":  "string",
                                                                                                                                                     "enum":  [
                                                                                                                                                                  "ARGUMENT",
                                                                                                                                                                  "RETURN"
                                                                                                                                                              ]
                                                                                                                                                 },
                                                                                                                                      "argumentIndex":  {
                                                                                                                                                            "oneOf":  [
                                                                                                                                                                          {
                                                                                                                                                                              "type":  "integer",
                                                                                                                                                                              "minimum":  0
                                                                                                                                                                          },
                                                                                                                                                                          {
                                                                                                                                                                              "type":  "null"
                                                                                                                                                                          }
                                                                                                                                                                      ]
                                                                                                                                                        },
                                                                                                                                      "fieldPath":  {
                                                                                                                                                        "type":  "array",
                                                                                                                                                        "maxItems":  8,
                                                                                                                                                        "items":  {
                                                                                                                                                                      "type":  "string",
                                                                                                                                                                      "pattern":  "^[A-Za-z_$][A-Za-z0-9_$]*$"
                                                                                                                                                                  }
                                                                                                                                                    },
                                                                                                                                      "required":  {
                                                                                                                                                       "type":  "boolean"
                                                                                                                                                   }
                                                                                                                                  }
                                                                                                               }
                                                                                                 }
                                                                             }
                                                          }
                                            }
                   },
    "$defs":  {
                  "intent":  {
                                 "type":  "object",
                                 "additionalProperties":  false,
                                 "required":  [
                                                  "questionToAnswer",
                                                  "hypothesis",
                                                  "basedOnEvidenceIds",
                                                  "expectedObservations"
                                              ],
                                 "properties":  {
                                                    "questionToAnswer":  {
                                                                             "type":  "string",
                                                                             "minLength":  1,
                                                                             "maxLength":  2048
                                                                         },
                                                    "hypothesis":  {
                                                                       "type":  "string",
                                                                       "minLength":  1,
                                                                       "maxLength":  4096
                                                                   },
                                                    "basedOnEvidenceIds":  {
                                                                               "type":  "array",
                                                                               "maxItems":  20,
                                                                               "uniqueItems":  true,
                                                                               "items":  {
                                                                                             "type":  "string",
                                                                                             "minLength":  1,
                                                                                             "maxLength":  128
                                                                                         }
                                                                           },
                                                    "expectedObservations":  {
                                                                                 "type":  "array",
                                                                                 "minItems":  1,
                                                                                 "maxItems":  20,
                                                                                 "uniqueItems":  true,
                                                                                 "items":  {
                                                                                               "type":  "string",
                                                                                               "minLength":  1,
                                                                                               "maxLength":  1024
                                                                                           }
                                                                             }
                                                }
                             },
                  "targetTest":  {
                                     "type":  "object",
                                     "additionalProperties":  false,
                                     "required":  [
                                                      "className",
                                                      "methodName"
                                                  ],
                                     "properties":  {
                                                        "className":  {
                                                                          "type":  "string",
                                                                          "minLength":  1
                                                                      },
                                                        "methodName":  {
                                                                           "type":  "string",
                                                                           "minLength":  1
                                                                       }
                                                    }
                                 },
                  "selector":  {
                                   "type":  "object",
                                   "additionalProperties":  false,
                                   "required":  [
                                                    "methodKey",
                                                    "className",
                                                    "methodName",
                                                    "descriptor"
                                                ],
                                   "properties":  {
                                                      "methodKey":  {
                                                                        "type":  "string",
                                                                        "minLength":  1,
                                                                        "maxLength":  1024
                                                                    },
                                                      "className":  {
                                                                        "type":  "string",
                                                                        "minLength":  1
                                                                    },
                                                      "methodName":  {
                                                                         "type":  "string",
                                                                         "minLength":  1
                                                                     },
                                                      "descriptor":  {
                                                                         "type":  "string",
                                                                         "minLength":  3
                                                                     }
                                                  }
                               },
                  "budget":  {
                                 "type":  "object",
                                 "additionalProperties":  false,
                                 "required":  [
                                                  "maxEvents",
                                                  "maxBytes",
                                                  "timeoutMillis"
                                              ],
                                 "properties":  {
                                                    "maxEvents":  {
                                                                      "type":  "integer",
                                                                      "minimum":  1,
                                                                      "maximum":  1000000
                                                                  },
                                                    "maxBytes":  {
                                                                     "type":  "integer",
                                                                     "minimum":  1,
                                                                     "maximum":  52428800
                                                                 },
                                                    "timeoutMillis":  {
                                                                          "type":  "integer",
                                                                          "minimum":  1,
                                                                          "maximum":  1200000
                                                                      }
                                                }
                             }
              },
    "title":  "CodePathCollectionPlan v4"
}
