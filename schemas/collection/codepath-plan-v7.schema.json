{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://algorithm-debug-agent.local/schemas/collection/codepath-plan-v7.schema.json",
  "title": "CodePathCollectionPlan v7",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "planId", "caseId", "analysisId", "targetTest",
    "methodSelections", "scopeConditions", "captureMode", "scopeStartOrdinal",
    "maxMatchedScopes", "budget", "rationale", "questionToAnswer",
    "investigationStatus", "investigationBinding", "createdAt"
  ],
  "properties": {
    "schemaVersion": {"const": "7.0"},
    "planId": {"$ref": "#/$defs/id"},
    "caseId": {"$ref": "#/$defs/id"},
    "analysisId": {"$ref": "#/$defs/id"},
    "targetTest": {"$ref": "#/$defs/targetTest"},
    "methodSelections": {
      "type": "array", "minItems": 1, "maxItems": 50,
      "items": {"$ref": "#/$defs/methodSelection"}
    },
    "scopeMethodKey": {
      "oneOf": [
        {"type": "string", "minLength": 1, "maxLength": 2048},
        {"type": "null"}
      ]
    },
    "scopeConditions": {
      "type": "array", "maxItems": 4,
      "items": {"$ref": "#/$defs/scopeCondition"}
    },
    "captureMode": {"enum": ["TRACE", "AGGREGATE"]},
    "scopeStartOrdinal": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "maxMatchedScopes": {"type": "integer", "minimum": 1, "maximum": 10000},
    "budget": {"$ref": "#/$defs/budget"},
    "rationale": {"type": "string", "minLength": 1, "maxLength": 4096},
    "questionToAnswer": {"type": "string", "minLength": 1, "maxLength": 2048},
    "investigationStatus": {"const": "STRUCTURED"},
    "investigationBinding": {"$ref": "#/$defs/investigationBinding"},
    "createdAt": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128},
    "targetTest": {
      "type": "object", "additionalProperties": false,
      "required": ["className", "methodName"],
      "properties": {
        "className": {"type": "string", "minLength": 1},
        "methodName": {"type": "string", "minLength": 1}
      }
    },
    "methodSelection": {
      "type": "object", "additionalProperties": false,
      "required": ["selector", "projections"],
      "properties": {
        "selector": {"$ref": "#/$defs/methodSelector"},
        "projections": {
          "type": "array", "maxItems": 32,
          "items": {"$ref": "#/$defs/projection"}
        }
      }
    },
    "methodSelector": {
      "type": "object", "additionalProperties": false,
      "required": ["methodKey", "className", "methodName", "descriptor"],
      "properties": {
        "methodKey": {"type": "string", "minLength": 1, "maxLength": 2048},
        "className": {"type": "string", "minLength": 1, "maxLength": 1024},
        "methodName": {"type": "string", "minLength": 1, "maxLength": 512},
        "descriptor": {"type": "string", "minLength": 3, "maxLength": 2048}
      }
    },
    "projection": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "source", "argumentIndex", "fieldPath", "required"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "source": {"enum": ["ARGUMENT", "RETURN"]},
        "argumentIndex": {
          "oneOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]
        },
        "fieldPath": {
          "type": "array", "maxItems": 8,
          "items": {"type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"}
        },
        "required": {"type": "boolean"}
      }
    },
    "scopeCondition": {
      "type": "object", "additionalProperties": false,
      "required": ["projectionName", "expectedType", "expectedValue"],
      "properties": {
        "projectionName": {"type": "string", "minLength": 1, "maxLength": 128},
        "expectedType": {"enum": ["STRING", "INTEGER", "DECIMAL", "BOOLEAN", "NULL"]},
        "expectedValue": {"type": ["string", "number", "boolean", "null"]}
      }
    },
    "budget": {
      "type": "object", "additionalProperties": false,
      "required": ["maxEvents", "maxBytes", "timeoutMillis"],
      "properties": {
        "maxEvents": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "maxBytes": {"type": "integer", "minimum": 1, "maximum": 52428800},
        "timeoutMillis": {"type": "integer", "minimum": 1, "maximum": 1200000}
      }
    },
    "investigationBinding": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schemaVersion", "caseId", "analysisId", "gapId", "hypothesisIds",
        "predicateIds", "basedOnEvidenceIds"
      ],
      "properties": {
        "schemaVersion": {"const": "1.0"},
        "caseId": {"$ref": "#/$defs/id"},
        "analysisId": {"$ref": "#/$defs/id"},
        "gapId": {"$ref": "#/$defs/id"},
        "hypothesisIds": {
          "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "predicateIds": {
          "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "basedOnEvidenceIds": {
          "type": "array", "maxItems": 128, "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        }
      }
    }
  }
}
