{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://algorithm-debug-agent.local/schemas/collection/collection-execution-summary-v2.schema.json",
  "title": "Collection Execution Summary v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "caseId",
    "analysisId",
    "runId",
    "planId",
    "collectionId",
    "completion",
    "baselineOutcome",
    "evidenceUsable",
    "artifactRelativePaths",
    "artifactIds"
  ],
  "properties": {
    "caseId": {
      "type": "string"
    },
    "analysisId": {
      "type": "string"
    },
    "runId": {
      "type": "string"
    },
    "planId": {
      "type": "string"
    },
    "collectionId": {
      "type": "string"
    },
    "completion": {
      "type": "string",
      "maxLength": 64
    },
    "baselineOutcome": {
      "enum": [
        "MATCHED",
        "CHANGED",
        "INCOMPARABLE",
        "NOT_COMPARED"
      ]
    },
    "evidenceUsable": {
      "type": "boolean"
    },
    "artifactRelativePaths": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "maxLength": 1024
      }
    },
    "artifactIds": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "maxLength": 160
      }
    },
    "sourceCoverage": {"enum": ["COMPLETE", "PARTIAL", "UNKNOWN"]},
    "reasonCodes": {
      "type": "array", "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 128}
    },
    "primaryArtifactId": {
      "oneOf": [{"type": "string", "minLength": 1, "maxLength": 160}, {"type": "null"}]
    },
    "recommendedTool": {"type": "string", "maxLength": 64},
    "supportedModes": {
      "type": "array", "maxItems": 5, "uniqueItems": true,
      "items": {"enum": ["SUMMARY", "FILTER", "WINDOW", "COUNT", "CHANGES"]}
    },
    "nextAction": {"type": "string", "minLength": 1, "maxLength": 256}
  }
}
