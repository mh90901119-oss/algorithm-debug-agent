{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://algorithm-debug-agent.local/schemas/execution/run-request-v2.schema.json",
  "title": "RunRequest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "caseId",
    "analysisId",
    "runId",
    "targetTest",
    "executionMode",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0"
    },
    "caseId": {
      "$ref": "#/$defs/id"
    },
    "analysisId": {
      "$ref": "#/$defs/id"
    },
    "runId": {
      "$ref": "#/$defs/id"
    },
    "targetTest": {
      "$ref": "#/$defs/targetTest"
    },
    "executionMode": {
      "const": "UNINSTRUMENTED"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "targetTest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "className",
        "methodName"
      ],
      "properties": {
        "className": {
          "type": "string",
          "minLength": 3
        },
        "methodName": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
