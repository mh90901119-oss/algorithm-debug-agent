{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://algorithm-debug-agent.local/schema/run-result-fingerprint-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "caseId",
    "analysisId",
    "runId",
    "targetFailureSha256"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0"
    },
    "caseId": {
      "type": "string",
      "minLength": 1
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "targetFailureSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "analysisId": {
      "type": "string",
      "minLength": 1
    }
  }
}
