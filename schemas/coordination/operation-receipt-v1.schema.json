{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/algorithm-debug/schemas/coordination/operation-receipt-v1.schema.json",
  "title": "OperationReceipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "operationId", "identity", "actionType", "outcome",
    "inputSha256", "replayed", "resultArtifactId", "errorCode"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "operationId": { "$ref": "#/$defs/opaqueId" },
    "identity": { "$ref": "#/$defs/identity" },
    "actionType": { "$ref": "#/$defs/actionType" },
    "outcome": { "enum": ["SUCCEEDED", "REJECTED", "FAILED"] },
    "inputSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "replayed": { "type": "boolean" },
    "resultArtifactId": { "anyOf": [{ "$ref": "#/$defs/opaqueId" }, { "type": "null" }] },
    "errorCode": { "anyOf": [{ "$ref": "#/$defs/errorCode" }, { "type": "null" }] }
  },
  "allOf": [
    {
      "if": { "properties": { "outcome": { "const": "SUCCEEDED" } } },
      "then": { "properties": { "errorCode": { "type": "null" } } },
      "else": { "properties": { "errorCode": { "$ref": "#/$defs/errorCode" } } }
    }
  ],
  "$defs": {
    "opaqueId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["projectId", "caseId", "analysisId"],
      "properties": {
        "projectId": { "$ref": "#/$defs/opaqueId" },
        "caseId": { "$ref": "#/$defs/opaqueId" },
        "analysisId": { "$ref": "#/$defs/opaqueId" }
      }
    },
    "actionType": {
      "type": "string",
      "enum": [
        "ANALYSIS_BEGIN", "CASE_INSPECT", "ALGORITHM_INPUT_CAPTURE", "CASE_AUDIT",
        "GANTT_INSPECT", "RUN_TEST", "STATIC_ANALYZE", "SOURCE_QUERY",
        "INVESTIGATION_UPDATE", "CODEPATH_PLAN_CREATE", "CODEPATH_COLLECT",
        "JDWP_PLAN_CREATE", "JDWP_COLLECT", "ARTIFACT_READ", "EVIDENCE_QUERY",
        "ANALYSIS_STATUS", "ANALYSIS_FINALIZE"
      ]
    },
    "errorCode": {
      "enum": [
        "COORDINATION_IDENTITY_MISMATCH", "COORDINATION_ACTION_NOT_ALLOWED",
        "COORDINATION_STATE_INVALID", "COORDINATION_PREREQUISITE_MISSING",
        "COORDINATION_POSTCONDITION_FAILED", "ACTION_OPERATION_ID_REQUIRED",
        "TARGET_EXECUTION_BUSY", "OPERATION_IN_PROGRESS", "OPERATION_UNCERTAIN",
        "OPERATION_JOURNAL_CONFLICT", "CONCLUSION_NOT_ELIGIBLE"
      ]
    }
  }
}
