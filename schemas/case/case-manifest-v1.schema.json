{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://algorithm-debug-agent.local/schemas/case/case-manifest-v1.schema.json",
  "title": "CaseManifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "caseId", "projectId", "targetTest", "initialQuestion", "createdAt"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "caseId": { "$ref": "#/$defs/id" },
    "projectId": { "$ref": "#/$defs/id" },
    "targetTest": { "$ref": "#/$defs/targetTest" },
    "initialQuestion": { "type": "string", "minLength": 1, "maxLength": 65536 },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "targetTest": {
      "type": "object", "additionalProperties": false,
      "required": ["className", "methodName"],
      "properties": {
        "className": { "type": "string", "minLength": 3 },
        "methodName": { "type": "string", "minLength": 1 }
      }
    }
  }
}
