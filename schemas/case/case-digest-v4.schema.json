{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://algorithm-debug-agent.local/schemas/case/case-digest-v4.schema.json",
  "title": "CaseDigest v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "caseId", "projectId", "targetTest", "latestAnalysisId",
    "latestQuestionExcerpt", "latestRunId", "recentRuns", "incompleteRuns",
    "recentCollections", "recentEvidence", "archiveWarnings", "analysisCount",
    "runCount", "collectionCount", "evidenceCount", "truncated"
  ],
  "properties": {
    "schemaVersion": {"const": "4.0"},
    "caseId": {"$ref": "#/$defs/id"},
    "projectId": {"$ref": "#/$defs/id"},
    "targetTest": {"type": "object"},
    "latestAnalysisId": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]
    },
    "latestQuestionExcerpt": {"type": "string", "minLength": 1, "maxLength": 2048},
    "latestRunId": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]
    },
    "recentRuns": {"$ref": "#/$defs/boundedObjects"},
    "incompleteRuns": {
      "type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/id"}
    },
    "recentCollections": {"$ref": "#/$defs/boundedObjects"},
    "recentEvidence": {"$ref": "#/$defs/boundedObjects"},
    "archiveWarnings": {"$ref": "#/$defs/boundedObjects"},
    "analysisCount": {"type": "integer", "minimum": 0},
    "runCount": {"type": "integer", "minimum": 0},
    "collectionCount": {"type": "integer", "minimum": 0},
    "evidenceCount": {"type": "integer", "minimum": 0},
    "truncated": {"type": "boolean"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128},
    "boundedObjects": {
      "type": "array", "maxItems": 20, "items": {"type": "object"}
    }
  }
}
