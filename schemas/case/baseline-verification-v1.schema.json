{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:algorithm-debug-agent:case:baseline-verification:1.0",
  "title": "BaselineVerification 1.0",
  "type": "object",
  "required": [
    "schemaVersion", "caseFingerprint", "canonicalSemanticHash",
    "requiredMatchingRuns", "observations", "state"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "caseFingerprint": { "type": "object" },
    "canonicalSemanticHash": { "$ref": "#/$defs/sha256" },
    "requiredMatchingRuns": { "type": "integer", "minimum": 2 },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["runId", "scheduleSemanticHash"],
        "properties": {
          "runId": { "type": "string", "minLength": 1 },
          "scheduleSemanticHash": { "$ref": "#/$defs/sha256" }
        },
        "additionalProperties": true
      }
    },
    "state": {
      "enum": ["BASELINE_CANDIDATE", "BASELINE_STABLE", "BASELINE_UNSTABLE"]
    }
  },
  "additionalProperties": true,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
