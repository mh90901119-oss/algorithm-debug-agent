{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://algorithm-debug-agent.local/schemas/trace/jdwp-raw-event-v2.schema.json",
  "title": "JDWP Raw JSONL Event v2",
  "type": "object",
  "required": ["schemaVersion", "sessionId", "sequence", "timestamp", "eventType"],
  "properties": {
    "schemaVersion": {"const": "2.0"},
    "sessionId": {"type": "string", "minLength": 1},
    "sequence": {"type": "integer", "minimum": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "eventType": {"enum": ["collector_started", "tracepoint_hit", "collector_finished"]},
    "tracepointId": {"type": "string", "minLength": 1},
    "hit": {"type": "integer", "minimum": 1},
    "thread": {"type": "object"},
    "location": {
      "type": "object",
      "required": ["className", "methodName", "methodDescriptor", "line", "codeIndex"],
      "properties": {
        "className": {"type": "string", "minLength": 1},
        "methodName": {"type": "string", "minLength": 1},
        "methodDescriptor": {"type": "string", "minLength": 3},
        "line": {"type": "integer", "minimum": 1},
        "codeIndex": {"type": "integer", "minimum": 0}
      }
    },
    "frames": {"type": "array"}
  }
}
