{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://algorithm-debug-agent.local/schemas/trace/jdwp-snapshot-summary-v1.schema.json",
  "title": "JdwpSnapshotSummary v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "evidenceId", "caseId", "contextId", "analysisId", "runId", "planId", "collectionId", "rawTrace", "hits", "limits", "truncated", "createdAt"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "evidenceId": {"type": "string"}, "caseId": {"type": "string"},
    "contextId": {"type": "string"}, "analysisId": {"type": "string"},
    "runId": {"type": "string"}, "planId": {"type": "string"},
    "collectionId": {"type": "string"}, "rawTrace": {"type": "object"},
    "hits": {"type": "array", "maxItems": 1000, "items": {"type": "object"}},
    "limits": {"type": "array", "maxItems": 1024, "items": {"type": "object"}},
    "truncated": {"type": "boolean"}, "createdAt": {"type": "string", "format": "date-time"}
  }
}
