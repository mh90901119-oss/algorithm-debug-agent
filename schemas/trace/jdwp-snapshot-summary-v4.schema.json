{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://algorithm-debug-agent.local/schemas/trace/jdwp-snapshot-summary-v4.schema.json",
  "title": "JdwpSnapshotSummary v4",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "evidenceId", "caseId", "analysisId", "runId", "planId", "collectionId", "rawTrace", "hits", "limitations", "truncated", "createdAt"],
  "properties": {
    "schemaVersion": {"const": "4.0"},
    "evidenceId": {"type": "string"},
    "caseId": {"type": "string"},
    "analysisId": {"type": "string"},
    "runId": {"type": "string"},
    "planId": {"type": "string"},
    "collectionId": {"type": "string"},
    "rawTrace": {"type": "object"},
    "hits": {
      "type": "array", "maxItems": 1000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["tracepointId", "observedHit", "matchedHit", "capturedHit", "threadName", "location", "methodDescriptor", "codeIndex", "frames", "projections", "provenance"],
        "properties": {
          "tracepointId": {"type": "string"},
          "observedHit": {"type": "integer", "minimum": 1},
          "matchedHit": {"type": "integer", "minimum": 1},
          "capturedHit": {"type": "integer", "minimum": 1},
          "threadName": {"type": "string"},
          "location": {"type": "string"},
          "methodDescriptor": {"type": ["string", "null"]},
          "codeIndex": {"type": ["integer", "null"], "minimum": 0},
          "frames": {"type": "array"},
          "projections": {
            "type": "array", "maxItems": 128,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["valuePath", "status", "kind", "runtimeType", "scalarValue", "valueTruncated", "objectId", "reason", "provenance"],
              "properties": {
                "valuePath": {"type": "string"},
                "status": {"enum": ["CAPTURED", "TRUNCATED", "REFERENCE_ONLY", "UNAVAILABLE"]},
                "kind": {"type": ["string", "null"]},
                "runtimeType": {"type": ["string", "null"]},
                "scalarValue": {"type": ["string", "null"]},
                "valueTruncated": {"type": "boolean"},
                "objectId": {"type": ["integer", "null"], "minimum": 0},
                "reason": {"type": ["string", "null"]},
                "provenance": {"type": "object"}
              }
            }
          },
          "provenance": {"type": "object"}
        }
      }
    },
    "limitations": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
    "truncated": {"type": "boolean"},
    "createdAt": {"type": "string", "format": "date-time"}
  }
}
