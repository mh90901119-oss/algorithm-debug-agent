{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://algorithm-debug-agent.local/schemas/trace/method-path-summary-v1.schema.json",
  "title": "MethodPathSummary v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "evidenceId", "caseId", "contextId", "analysisId", "runId", "planId", "collectionId", "rawTrace", "matchPrecision", "methods", "observedPaths", "anomalies", "truncated", "createdAt"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "evidenceId": {"type": "string"}, "caseId": {"type": "string"},
    "contextId": {"type": "string"}, "analysisId": {"type": "string"},
    "runId": {"type": "string"}, "planId": {"type": "string"},
    "collectionId": {"type": "string"}, "rawTrace": {"type": "object"},
    "matchPrecision": {"enum": ["EXACT_DESCRIPTOR", "CLASS_METHOD_SUPERSET", "NONE"]},
    "methods": {"type": "array", "maxItems": 200, "items": {"type": "object"}},
    "observedPaths": {"type": "array", "maxItems": 10000, "items": {"type": "object"}},
    "anomalies": {"type": "array", "maxItems": 10000, "items": {"type": "object"}},
    "truncated": {"type": "boolean"}, "createdAt": {"type": "string", "format": "date-time"}
  }
}
