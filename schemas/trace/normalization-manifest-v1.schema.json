{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://algorithm-debug-agent.local/schemas/trace/normalization-manifest-v1.schema.json",
  "title": "NormalizationManifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "evidenceId", "caseId", "contextId", "analysisId", "runId", "planId", "collectionId", "collectorType", "normalizerName", "normalizerVersion", "status", "rawArtifact", "summaryArtifact", "budget", "inputRecordCount", "emittedFactCount", "truncationReasons", "failureCode", "failureDetail", "createdAt"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "evidenceId": {"type": "string", "minLength": 1, "maxLength": 128},
    "caseId": {"type": "string", "minLength": 1, "maxLength": 128},
    "contextId": {"type": "string", "minLength": 1, "maxLength": 128},
    "analysisId": {"type": "string", "minLength": 1, "maxLength": 128},
    "runId": {"type": "string", "minLength": 1, "maxLength": 128},
    "planId": {"type": "string", "minLength": 1, "maxLength": 128},
    "collectionId": {"type": "string", "minLength": 1, "maxLength": 128},
    "collectorType": {"enum": ["CODEPATH", "JDWP"]},
    "normalizerName": {"type": "string", "minLength": 1, "maxLength": 128},
    "normalizerVersion": {"type": "string", "minLength": 1, "maxLength": 64},
    "status": {"enum": ["COMPLETE", "PARTIAL", "FAILED"]},
    "rawArtifact": {"type": "object"},
    "summaryArtifact": {"type": ["object", "null"]},
    "budget": {"type": "object"},
    "inputRecordCount": {"type": "integer", "minimum": 0},
    "emittedFactCount": {"type": "integer", "minimum": 0},
    "truncationReasons": {"type": "array", "maxItems": 32, "items": {"type": "string", "maxLength": 2048}},
    "failureCode": {"type": ["string", "null"], "maxLength": 128},
    "failureDetail": {"type": "string", "maxLength": 2048},
    "createdAt": {"type": "string", "format": "date-time"}
  }
}
